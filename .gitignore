# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets) — but keep the placeholder template committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source art (heavy PNG masters) — the optimised copies live in public/assets/images/hero/capas
design-assets/

# Never ship design masters from public/ — they are 1-1.5MB each and the
# optimised AVIF/WebP renditions are what the site actually loads.
public/**/Meshy_AI_*
public/**/Untitled-*
